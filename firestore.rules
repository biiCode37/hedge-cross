rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Whitelist dispatcher rules
    match /authorized_dispatchers/{email} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Routes, master fleet and drivers: allow read and write for app sync
    match /routes/{routeId} {
      allow read, write: if true;
    }
    // Outbox telemetry events
    match /outbox/{docId} {
      allow create, read, update, delete: if true;
    }
  }
}
